{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/superdeterminism/relationship-v0.1.schema.json",
  "title": "Relationship v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "endpoints",
    "provenance_mode",
    "scope_alignment",
    "evidence_ids",
    "rationale",
    "consequence",
    "status",
    "created_by"
  ],
  "properties": {
    "schema_version": { "const": "relationship-v0.1" },
    "id": { "type": "string", "pattern": "^R-[0-9]{6,}$" },
    "kind": {
      "type": "string",
      "enum": [
        "same_referent",
        "alias_of",
        "version_of",
        "equivalent_to",
        "supports",
        "fails_to_support",
        "replicates",
        "fails_to_replicate",
        "entails",
        "contradicts",
        "consistent_with",
        "independent_of",
        "qualifies",
        "narrows",
        "broadens",
        "special_case_of",
        "boundary_condition_for",
        "extends",
        "generalizes",
        "refines",
        "corrects",
        "supersedes",
        "assumes",
        "requires",
        "uses",
        "derived_from",
        "motivates",
        "defines",
        "measures",
        "operationalizes",
        "tests",
        "predicts",
        "objects_to",
        "answers",
        "partially_answers",
        "leaves_open",
        "reframes",
        "agrees_with",
        "disagrees_with",
        "apparent_tension_with",
        "uses_different_definition"
      ]
    },
    "endpoints": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_id", "role"],
        "properties": {
          "object_id": { "type": "string", "pattern": "^(A-|C-)" },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance_mode": {
      "type": "string",
      "enum": ["source_asserted", "system_synthesis", "human_judgment"]
    },
    "scope_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "dimensions_checked"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["aligned", "partially_aligned", "different_scope", "unresolved", "not_applicable"]
        },
        "dimensions_checked": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "conflict_dimension": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^E-" },
      "uniqueItems": true
    },
    "rationale": { "type": "string", "minLength": 1 },
    "consequence": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["proposed", "verified", "rejected", "needs_review", "superseded"]
    },
    "rejection_reason": { "type": ["string", "null"] },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "supersedes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^R-" },
      "uniqueItems": true
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "run_id", "created_at"],
      "properties": {
        "actor": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
