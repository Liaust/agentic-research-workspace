{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liaust.example/research-map/v1/corpus-cross-reference-plan.schema.json",
  "title": "Bounded corpus cross-reference plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "source_ids",
    "source_count",
    "limits",
    "blocks",
    "shards",
    "pair_count",
    "owned_pair_count",
    "planning_failures",
    "uncovered_pairs"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "kind": { "type": "string", "const": "corpus_cross_reference_plan" },
    "run_id": { "type": "string", "minLength": 1 },
    "eligibility_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_manifest_kind": {
      "type": "string",
      "const": "corpus_source_quality_manifest"
    },
    "quality_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_inputs": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/sourceInput" }
    },
    "source_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceId" }
    },
    "source_count": { "type": "integer", "minimum": 2 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_sources_per_block",
        "max_dossier_bytes_per_block",
        "max_mapper_input_bytes",
        "mapper_workers",
        "semantic_attempts_per_job",
        "automatic_retries"
      ],
      "properties": {
        "max_sources_per_block": { "type": "integer", "minimum": 1 },
        "max_dossier_bytes_per_block": { "type": "integer", "minimum": 1 },
        "max_mapper_input_bytes": { "type": "integer", "minimum": 1 },
        "mapper_workers": { "type": "integer", "const": 2 },
        "semantic_attempts_per_job": { "type": "integer", "const": 1 },
        "automatic_retries": { "type": "integer", "const": 0 }
      }
    },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    },
    "shards": {
      "type": "array",
      "items": { "$ref": "#/$defs/shard" }
    },
    "pair_count": { "type": "integer", "minimum": 1 },
    "owned_pair_count": { "type": "integer", "minimum": 0 },
    "planning_failures": {
      "type": "array",
      "items": { "$ref": "#/$defs/planningFailure" }
    },
    "uncovered_pairs": {
      "type": "array",
      "items": { "$ref": "#/$defs/ownedPair" }
    }
  },
  "oneOf": [
    {
      "required": ["eligibility_manifest_sha256"],
      "not": {
        "anyOf": [
          { "required": ["source_manifest_kind"] },
          { "required": ["quality_manifest_sha256"] },
          { "required": ["source_inputs"] }
        ]
      }
    },
    {
      "required": [
        "source_manifest_kind",
        "quality_manifest_sha256",
        "source_inputs"
      ],
      "not": { "required": ["eligibility_manifest_sha256"] }
    }
  ],
  "$defs": {
    "sourceId": { "type": "string", "pattern": "^LIB-[0-9]{3}$" },
    "sourceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "quality_label",
        "selection_receipt_sha256",
        "dossier_sha256",
        "graph_sha256",
        "findings_sha256"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/sourceId" },
        "quality_label": {
          "type": "string",
          "enum": [
            "audited_passed",
            "audited_with_findings",
            "audit_interrupted",
            "unaudited_provisional"
          ]
        },
        "selection_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "dossier_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "graph_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "findings_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "source_ids", "dossier_bytes", "source_count"],
      "properties": {
        "block_id": { "type": "string", "pattern": "^xref_block_[0-9a-f]{24}$" },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        },
        "dossier_bytes": { "type": "integer", "minimum": 1 },
        "source_count": { "type": "integer", "minimum": 1 }
      }
    },
    "ownedPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_key", "source_ids"],
      "properties": {
        "pair_key": { "type": "string", "pattern": "^pair-lib-[0-9]{3}-lib-[0-9]{3}$" },
        "source_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      }
    },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shard_id",
        "left_block_id",
        "right_block_id",
        "source_ids",
        "dossier_bytes",
        "owned_pairs",
        "owned_pair_count",
        "no_op",
        "planning_failure"
      ],
      "properties": {
        "shard_id": { "type": "string", "pattern": "^xref_shard_[0-9a-f]{24}$" },
        "left_block_id": { "type": "string", "pattern": "^xref_block_[0-9a-f]{24}$" },
        "right_block_id": { "type": "string", "pattern": "^xref_block_[0-9a-f]{24}$" },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        },
        "dossier_bytes": { "type": "integer", "minimum": 1 },
        "owned_pairs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ownedPair" }
        },
        "owned_pair_count": { "type": "integer", "minimum": 0 },
        "no_op": { "type": "boolean" },
        "planning_failure": {
          "type": ["string", "null"],
          "enum": ["mapper_input_ceiling", null]
        }
      }
    },
    "planningFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_class", "source_ids", "shard_id", "reason"],
      "properties": {
        "failure_class": {
          "type": "string",
          "enum": ["source_mapper_input_ceiling", "mapper_input_ceiling"]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        },
        "shard_id": {
          "type": ["string", "null"],
          "pattern": "^xref_shard_[0-9a-f]{24}$"
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
