{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liaust.example/research-map/v1/thread.schema.json",
  "title": "Source-local scientific thread",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "id", "revision", "source_id", "kind",
    "title", "summary", "move_ids", "entry_points", "branches", "evidence_ids", "type_gap"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "thread" },
    "id": { "type": "string", "pattern": "^LIB-[0-9]{3}:thread:[a-z0-9][a-z0-9-]*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "source_id": { "type": "string", "pattern": "^LIB-[0-9]{3}$" },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "move_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "entry_points": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "branches": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from_move", "to_move", "label"],
        "properties": {
          "from_move": { "type": "string" },
          "to_move": { "type": "string" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "type_gap": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["slug", "rationale"],
          "properties": {
            "slug": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
