{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liaust.example/research-map/v1/failed-shard-corrected-proposal.schema.json",
  "title": "Complete corrected multi-surface proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "source_ids",
    "pair_coverage",
    "comparison_surfaces",
    "relationships",
    "warnings"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "batch_id": { "type": "string", "pattern": "^xref_batch_[0-9a-f]{24}$" },
    "source_ids": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "pattern": "^LIB-[0-9]{3}$" }
    },
    "pair_coverage": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pairCoverage" }
    },
    "comparison_surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/comparisonSurface" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "pairCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_key",
        "source_ids",
        "disposition",
        "comparison_surface_keys",
        "rationale"
      ],
      "properties": {
        "pair_key": {
          "type": "string",
          "pattern": "^pair-lib-[0-9]{3}-lib-[0-9]{3}$"
        },
        "source_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "pattern": "^LIB-[0-9]{3}$" }
        },
        "disposition": {
          "type": "string",
          "enum": [
            "surfaces_found",
            "no_useful_relationship",
            "manual_review_candidate"
          ]
        },
        "comparison_surface_keys": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "comparisonSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_key",
        "source_ids",
        "left_record_id",
        "right_record_id",
        "left_evidence_ids",
        "right_evidence_ids",
        "comparison_dimension",
        "precise_connection",
        "scope_alignment",
        "assumption_alignment",
        "disposition",
        "rationale",
        "qualifications"
      ],
      "properties": {
        "surface_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "source_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "pattern": "^LIB-[0-9]{3}$" }
        },
        "left_record_id": {
          "type": "string",
          "pattern": "^LIB-[0-9]{3}:atom:[a-z0-9][a-z0-9-]*$"
        },
        "right_record_id": {
          "type": "string",
          "pattern": "^LIB-[0-9]{3}:atom:[a-z0-9][a-z0-9-]*$"
        },
        "left_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^LIB-[0-9]{3}:evidence:[a-z0-9][a-z0-9-]*$"
          }
        },
        "right_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^LIB-[0-9]{3}:evidence:[a-z0-9][a-z0-9-]*$"
          }
        },
        "comparison_dimension": {
          "type": "string",
          "enum": [
            "definition",
            "assumption",
            "formalism",
            "method",
            "model_architecture",
            "result",
            "quantitative_finding",
            "limitation",
            "open_question",
            "objection_response",
            "other"
          ]
        },
        "precise_connection": { "type": "string", "minLength": 1 },
        "scope_alignment": { "type": "string", "minLength": 1 },
        "assumption_alignment": { "type": "string", "minLength": 1 },
        "disposition": {
          "type": "string",
          "enum": [
            "relationship_proposed",
            "ontology_gap_candidate",
            "no_allowed_relationship"
          ]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "qualifications": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_key",
        "left_record_id",
        "right_record_id",
        "relation_type",
        "direction",
        "left_evidence_ids",
        "right_evidence_ids",
        "comparison_surface",
        "scope_alignment",
        "assumption_alignment",
        "rationale",
        "qualifications"
      ],
      "properties": {
        "surface_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "left_record_id": {
          "type": "string",
          "pattern": "^LIB-[0-9]{3}:atom:[a-z0-9][a-z0-9-]*$"
        },
        "right_record_id": {
          "type": "string",
          "pattern": "^LIB-[0-9]{3}:atom:[a-z0-9][a-z0-9-]*$"
        },
        "relation_type": {
          "type": "string",
          "enum": [
            "potential_same_referent",
            "potential_same_definition",
            "potential_equivalence",
            "potential_support",
            "potential_qualification",
            "potential_tension",
            "potential_contradiction",
            "potential_dependency"
          ]
        },
        "direction": {
          "type": "string",
          "enum": ["symmetric", "left_to_right", "right_to_left"]
        },
        "left_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^LIB-[0-9]{3}:evidence:[a-z0-9][a-z0-9-]*$"
          }
        },
        "right_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^LIB-[0-9]{3}:evidence:[a-z0-9][a-z0-9-]*$"
          }
        },
        "comparison_surface": { "type": "string", "minLength": 1 },
        "scope_alignment": { "type": "string", "minLength": 1 },
        "assumption_alignment": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "qualifications": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
