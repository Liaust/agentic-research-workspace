{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liaust.example/research-map/v1/move.schema.json",
  "title": "Source-local reasoning move",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "id", "revision", "source_id", "role",
    "label", "summary", "inputs", "outputs", "evidence_ids", "thread_id", "type_gap"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "move" },
    "id": { "type": "string", "pattern": "^LIB-[0-9]{3}:move:[a-z0-9][a-z0-9-]*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "source_id": { "type": "string", "pattern": "^LIB-[0-9]{3}$" },
    "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "label": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "inputs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "outputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "thread_id": { "type": "string" },
    "presentation_index": { "type": "integer", "minimum": 1 },
    "scientific_use": { "type": "string", "minLength": 1 },
    "type_gap": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["slug", "rationale"],
          "properties": {
            "slug": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
