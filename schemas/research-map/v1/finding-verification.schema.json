{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liaust.example/research-map/v1/finding-verification.schema.json",
  "title": "Independent verification of proposed audit findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "attempt", "decisions", "warnings"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "source_id": { "type": "string", "pattern": "^LIB-[0-9]{3}$" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id", "verdict", "source_evidence", "comparison",
          "manual_review_reason"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^LIB-[0-9]{3}:finding:[a-z0-9][a-z0-9-]*$"
          },
          "verdict": {
            "type": "string",
            "enum": ["confirmed", "rejected", "manual_review"]
          },
          "source_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "page_start", "page_end", "locator", "transcription",
                "transcription_mode", "inspection_mode"
              ],
              "properties": {
                "page_start": { "type": "integer", "minimum": 1 },
                "page_end": { "type": "integer", "minimum": 1 },
                "locator": { "type": "string", "minLength": 1 },
                "transcription": { "type": "string", "minLength": 1 },
                "transcription_mode": {
                  "type": "string",
                  "enum": [
                    "verbatim_text", "normalized_text", "displayed_math", "figure_region"
                  ]
                },
                "inspection_mode": {
                  "type": "string",
                  "enum": ["text_pdf", "visual_pdf", "text_and_visual_pdf"]
                }
              }
            }
          },
          "comparison": { "type": "string", "minLength": 1 },
          "manual_review_reason": { "type": ["string", "null"] }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
