{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liaust.example/research-map/v1/discovery-proposal.schema.json",
  "title": "Cross-reference candidate discovery proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_pair", "candidates", "warnings"],
  "properties": {
    "schema_version": { "const": 1 },
    "source_pair": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^LIB-[0-9]{3}$" }
    },
    "candidates": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["left_record_id", "right_record_id", "comparison_surface"],
        "properties": {
          "left_record_id": {
            "type": "string", "pattern": "^LIB-[0-9]{3}:atom:[a-z0-9][a-z0-9-]*$"
          },
          "right_record_id": {
            "type": "string", "pattern": "^LIB-[0-9]{3}:atom:[a-z0-9][a-z0-9-]*$"
          },
          "comparison_surface": { "type": "string", "minLength": 1 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
