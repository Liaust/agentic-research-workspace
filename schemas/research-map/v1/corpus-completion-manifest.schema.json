{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liaust.example/research-map/v1/corpus-completion-manifest.schema.json",
  "title": "Corpus completion launch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "source_run_id",
    "source_run_root",
    "destination_run_root",
    "source_run_terminal_summary_sha256",
    "source_model",
    "audit_model",
    "cross_reference_model",
    "canary_source_id",
    "source_ids",
    "excluded_source_ids",
    "audit_workers",
    "mapper_workers",
    "semantic_attempts_per_job",
    "automatic_retries",
    "max_sources_per_block",
    "max_dossier_bytes_per_block",
    "max_mapper_input_bytes",
    "approval_required"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "source_run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "source_run_root": { "type": "string", "pattern": "^\\.cache/research-map/corpus-runs/[a-z0-9][a-z0-9-]*$" },
    "destination_run_root": { "type": "string", "pattern": "^\\.cache/research-map/corpus-runs/[a-z0-9][a-z0-9-]*$" },
    "source_run_terminal_summary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_model": { "type": "string", "minLength": 1 },
    "audit_model": { "type": "string", "minLength": 1 },
    "cross_reference_model": { "type": "string", "minLength": 1 },
    "canary_source_id": { "type": "string", "pattern": "^LIB-[0-9]{3}$" },
    "source_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^LIB-[0-9]{3}$" }
    },
    "excluded_source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^LIB-[0-9]{3}$" }
    },
    "audit_workers": { "type": "integer", "const": 2 },
    "mapper_workers": { "type": "integer", "const": 2 },
    "semantic_attempts_per_job": { "type": "integer", "const": 1 },
    "automatic_retries": { "type": "integer", "const": 0 },
    "max_sources_per_block": { "type": "integer", "const": 8 },
    "max_dossier_bytes_per_block": { "type": "integer", "const": 900000 },
    "max_mapper_input_bytes": { "type": "integer", "const": 1800000 },
    "approval_required": { "type": "boolean", "const": true },
    "selection_policy": {
      "type": "string",
      "const": "quality_labelled_best_valid"
    },
    "prior_completion_run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "prior_completion_run_root": {
      "type": "string",
      "pattern": "^\\.cache/research-map/corpus-runs/[a-z0-9][a-z0-9-]*$"
    },
    "prior_completion_launch_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": { "required": ["selection_policy"] },
      "then": {
        "required": [
          "prior_completion_run_id",
          "prior_completion_run_root",
          "prior_completion_launch_plan_sha256"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["prior_completion_run_id"] },
            { "required": ["prior_completion_run_root"] },
            { "required": ["prior_completion_launch_plan_sha256"] }
          ]
        }
      }
    }
  ]
}
