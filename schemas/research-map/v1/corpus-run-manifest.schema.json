  "title": "Frozen paper-corpus run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "title",
    "projection_status",
    "terminal_stage",
    "reader_mode",
    "model",
    "canary_source_id",
    "source_workers",
