{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liaust.example/research-map/v1/relationship.schema.json",
  "title": "Canonical mapper-proposed cross-source relationship",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "relationship_id", "revision", "candidate_id", "batch_id",
    "relation_type", "direction", "left_endpoint", "right_endpoint",
    "left_evidence_ids", "right_evidence_ids", "comparison_surface",
    "scope_alignment", "assumption_alignment", "rationale", "qualifications",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "relationship_id": { "type": "string", "pattern": "^xref_rel_[0-9a-f]{24}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "candidate_id": { "type": "string", "pattern": "^xref_candidate_[0-9a-f]{24}$" },
    "batch_id": { "type": "string", "pattern": "^xref_batch_[0-9a-f]{24}$" },
    "relation_type": {
      "enum": [
        "potential_same_referent", "potential_same_definition",
        "potential_equivalence", "potential_support", "potential_qualification",
        "potential_tension", "potential_contradiction", "potential_dependency"
      ]
    },
    "direction": { "enum": ["symmetric", "left_to_right", "right_to_left"] },
    "left_endpoint": { "$ref": "#/$defs/endpoint" },
    "right_endpoint": { "$ref": "#/$defs/endpoint" },
    "left_evidence_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^LIB-[0-9]{3}:evidence:[a-z0-9][a-z0-9-]*$" }
    },
    "right_evidence_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^LIB-[0-9]{3}:evidence:[a-z0-9][a-z0-9-]*$" }
    },
    "comparison_surface": { "type": "string", "minLength": 1 },
    "scope_alignment": { "type": "string", "minLength": 1 },
    "assumption_alignment": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "qualifications": {
      "type": "array", "items": { "type": "string", "minLength": 1 }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "relation_type": {
            "enum": [
              "potential_same_referent", "potential_same_definition",
              "potential_equivalence", "potential_tension", "potential_contradiction"
            ]
          }
        },
        "required": ["relation_type"]
      },
      "then": { "properties": { "direction": { "const": "symmetric" } } },
      "else": { "properties": { "direction": { "enum": ["left_to_right", "right_to_left"] } } }
    }
  ],
  "$defs": {
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "record_id", "revision", "record_sha256"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^LIB-[0-9]{3}$" },
        "record_id": { "type": "string", "pattern": "^LIB-[0-9]{3}:atom:[a-z0-9][a-z0-9-]*$" },
        "revision": { "type": "integer", "minimum": 1 },
        "record_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": [
        "inspection_job_id", "model", "protocol_sha256", "schema_sha256", "input_sha256"
      ],
      "properties": {
        "inspection_job_id": { "type": "string", "pattern": "^xref_job_[0-9a-f]{24}$" },
        "model": { "type": "string", "minLength": 1 },
        "protocol_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
