{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liaust.example/research-map/v1/cross-reference-recovery-shard-receipt.schema.json",
  "title": "Immutable one-attempt failed-shard recovery receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "recovery_id", "shard_id", "original_job_id",
    "batch_id", "source_ids", "owned_pairs", "attempt", "outcome", "original",
    "correction", "admission", "pair_outcomes", "telemetry", "failure_reason"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "kind": { "type": "string", "const": "cross_reference_recovery_shard" },
    "recovery_id": { "type": "string", "minLength": 1 },
    "shard_id": { "type": "string", "minLength": 1 },
    "original_job_id": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string", "pattern": "^xref_batch_[0-9a-f]{24}$" },
    "source_ids": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^LIB-[0-9]{3}$" }
    },
    "owned_pairs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/pair" }
    },
    "attempt": { "type": "integer", "const": 1 },
    "outcome": {
      "type": "string",
      "enum": ["succeeded", "validation_failed", "worker_failed"]
    },
    "original": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt", "proposal", "validation_report"],
      "properties": {
        "receipt": { "$ref": "#/$defs/artifact" },
        "proposal": { "$ref": "#/$defs/artifact" },
        "validation_report": { "$ref": "#/$defs/validationReport" }
      }
    },
    "correction": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal", "validation_report"],
      "properties": {
        "proposal": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/fingerprintedArtifact" }
          ]
        },
        "validation_report": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/validationReport" }
          ]
        }
      }
    },
    "admission": { "type": ["object", "null"] },
    "pair_outcomes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/pairOutcome" }
    },
    "telemetry": { "$ref": "#/$defs/telemetry" },
    "failure_reason": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "succeeded" } } },
      "then": {
        "properties": {
          "correction": {
            "properties": {
              "proposal": { "$ref": "#/$defs/fingerprintedArtifact" },
              "validation_report": { "$ref": "#/$defs/validationReport" }
            }
          },
          "admission": { "type": "object" },
          "failure_reason": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "worker_failed" } } },
      "then": {
        "properties": {
          "correction": {
            "properties": {
              "proposal": { "type": "null" },
              "validation_report": { "type": "null" }
            }
          },
          "admission": { "type": "null" },
          "failure_reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "validation_failed" } } },
      "then": {
        "properties": {
          "admission": { "type": "null" },
          "failure_reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "fingerprintedArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "pair": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "string", "pattern": "^LIB-[0-9]{3}$" }
    },
    "validationReport": {
      "type": "object",
      "required": [
        "schema_version", "kind", "batch_id", "source_ids", "expected_pair_count",
        "has_fatal_findings", "finding_counts", "findings", "projection"
      ]
    },
    "pairOutcome": {
      "type": "object", "additionalProperties": false,
      "required": [
        "pair_key", "source_ids", "status", "ledger_disposition",
        "comparison_surface_keys"
      ],
      "properties": {
        "pair_key": { "type": "string", "minLength": 1 },
        "source_ids": { "$ref": "#/$defs/pair" },
        "status": { "type": "string", "enum": ["inspected", "unresolved", "shard_failed"] },
        "ledger_disposition": { "type": ["string", "null"] },
        "comparison_surface_keys": {
          "type": "array", "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": [
        "semantic_job_started", "duration_seconds", "worker_events_emitted", "token_usage"
      ],
      "properties": {
        "semantic_job_started": { "type": "boolean", "const": true },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "worker_events_emitted": { "type": "integer", "minimum": 0 },
        "token_usage": {
          "type": "object", "additionalProperties": false,
          "required": ["input_tokens", "cached_input_tokens", "output_tokens"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "cached_input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
